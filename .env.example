# Port (defaults to 8080 on Railway; also listens on 3000 for preview)
PORT=8080

# Security (Optional for local/preview, recommended for Railway production)
DASHBOARD_PASSWORD=

# Roblox Open Cloud API Key (Requires Assets:write and Assets:read permissions)
ROBLOX_API_KEY=

# Target Creator ID (Specify either User ID or Group ID)
ROBLOX_USER_ID=
ROBLOX_GROUP_ID=
